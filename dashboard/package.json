{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:unit": "vitest run --project=lib",
    "test:component": "vitest run --project=component",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:component && npm run test:e2e",
    "ingest": "tsx scripts/ingest.ts",
    "build:standalone": "next build && rm -rf dist-app && cp -r .next/standalone dist-app && cp -r .next/static dist-app/.next/static",
    "app:build": "npm run build:standalone && tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.9",
    "better-sqlite3": "^12.10.0",
    "lightweight-charts": "^4.2.3",
    "lucide-react": "^1.17.0",
    "next": "14.2.35",
    "papaparse": "^5.5.3",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.1",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "jsdom": "^26.0.0",
    "playwright": "^1.60.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
