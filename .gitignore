# Anchored: an unanchored data/ also swallowed argus/argus/data and
# dashboard/app/learn/data, both of them tracked source, so anything new added
# under either was silently left out of a public repo.
/data/
reports/
runs/

# Local code-graph cache. 320 files and 11MB of generated AST JSON, rebuilt by
# `graphify update .` at session start — a build artifact, not source.
graphify-out/

# Runtime config caches (regenerated by bridge / sector rotation)
config/sector_cache.json
config/rotation_ranks.json
config/sector_constituents.json

# Generated backtest output (tools/backtest/backtest_agents.py)
backtest_results.csv
reports/backtest_results.csv

# README preview assets only — ignore other daily-report PDFs and intermediate page PNGs
docs/assets/*.pdf
!docs/assets/sample-daily-report.pdf
docs/assets/report-preview/page-*.png

# Audit artifact (do not publish)
GITHUB_READINESS.md
.worktrees/
docs/weight_optimisation/price_cache.parquet
argus.db
argus.db-shm
argus.db-wal
argus/backtests/

# WS-5 vendored 0DTE app — runtime-provisioned artifacts
odte/frontend/node_modules/
odte/backend/.venv/
odte/**/__pycache__/
odte/**/.pytest_cache/

# The conformance handoff shipped the mock, its support script and the Playwright
# harness alongside its own documents. All three are byte-identical to the copies
# already tracked under design_handoff_argus_overhaul/ and dashboard/, so only the
# documents unique to that package are committed.
design_handoff_argus_conformance/mocks/
design_handoff_argus_conformance/support.js
design_handoff_argus_conformance/e2e/
